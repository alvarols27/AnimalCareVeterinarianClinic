<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AnimalCare Veterinary Clinic</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css">

    <style>
        * {
            box-sizing: border-box;
        }

        html {
            font-size: 14px;
        }

        #page-transition {
            animation: slideIn .5s ease;
        }

        @@keyframes slideIn {
            from {
                transform: translateX(20px);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        body {
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            zoom: 0.9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }

        :root {
            --primary-blue: #2563eb;
            --primary-blue-dark: #1e40af;
            --primary-blue-light: #3b82f6;
            --accent-blue: #0ea5e9;
            --bg-light: #f8fafc;
            --text-dark: #1e293b;
            --border-color: #e2e8f0;
        }

        .navbar {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%) !important;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            padding: 0.8rem 0;
            border: none !important;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: white !important;
            font-weight: 600;
            font-size: 1.1rem;
            transition: transform 0.3s ease;
        }

            .navbar-brand:hover {
                transform: translateY(-2px);
            }

        .logo-icon {
            width: 32px;
            height: 32px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        }

            .logo-icon::before {
                content: '';
                width: 16px;
                height: 16px;
                background: var(--primary-blue);
                border-radius: 50% 50% 0 50%;
                transform: rotate(-45deg);
                position: absolute;
            }

            .logo-icon::after {
                content: '';
                width: 6px;
                height: 6px;
                background: white;
                border-radius: 50%;
                position: absolute;
                top: 10px;
                left: 10px;
                z-index: 1;
            }

        .navbar-nav .nav-link {
            color: rgba(255, 255, 255, 0.9) !important;
            font-weight: 500;
            padding: 0.35rem 0.6rem !important;
            border-radius: 6px;
            transition: all 0.3s ease;
            margin: 0 0.05rem;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 5px;
        }

            .navbar-nav .nav-link:hover {
                background: rgba(255, 255, 255, 0.15);
                color: white !important;
                transform: translateY(-1px);
            }

            .navbar-nav .nav-link:active {
                background: rgba(255, 255, 255, 0.2);
            }

        .nav-icon {
            width: 14px;
            height: 14px;
            display: inline-block;
            position: relative;
            flex-shrink: 0;
        }

        .icon-owners {
            background: transparent;
            position: relative;
        }

            .icon-owners::before {
                content: '';
                position: absolute;
                width: 5px;
                height: 5px;
                background: white;
                border-radius: 50%;
                top: 0;
                left: 2px;
            }

            .icon-owners::after {
                content: '';
                position: absolute;
                width: 7px;
                height: 5px;
                background: white;
                border-radius: 3px 3px 0 0;
                bottom: 0;
                left: 1px;
            }

        .icon-animals {
            background: white;
            border-radius: 50%;
            width: 8px;
            height: 8px;
            margin: 3px;
            position: relative;
        }

            .icon-animals::before,
            .icon-animals::after {
                content: '';
                position: absolute;
                width: 4px;
                height: 4px;
                background: white;
                border-radius: 50%;
                top: -2px;
            }

            .icon-animals::before {
                left: 0;
            }

            .icon-animals::after {
                right: 0;
            }

        .icon-vets {
            position: relative;
        }

            .icon-vets::before {
                content: '';
                position: absolute;
                width: 10px;
                height: 3px;
                background: white;
                top: 5px;
                left: 2px;
            }

            .icon-vets::after {
                content: '';
                position: absolute;
                width: 3px;
                height: 10px;
                background: white;
                top: 2px;
                left: 5px;
            }

        .icon-appointments {
            border: 2px solid white;
            border-radius: 2px;
            position: relative;
        }

            .icon-appointments::before {
                content: '';
                position: absolute;
                width: 8px;
                height: 2px;
                background: white;
                top: 3px;
                left: 0px;
            }

            .icon-appointments::after {
                content: '';
                position: absolute;
                width: 2px;
                height: 3px;
                background: white;
                top: -4px;
                left: 2px;
                box-shadow: 5px 0 0 white;
            }

        .icon-schedules {
            border: 2px solid white;
            border-radius: 50%;
            position: relative;
        }

            .icon-schedules::before {
                content: '';
                position: absolute;
                width: 1px;
                height: 4px;
                background: white;
                top: 2px;
                left: 5px;
            }

            .icon-schedules::after {
                content: '';
                position: absolute;
                width: 3px;
                height: 1px;
                background: white;
                top: 5px;
                left: 6px;
            }

        .icon-medical {
            border: 2px solid white;
            border-radius: 2px;
            width: 10px;
            height: 12px;
            margin: 1px 2px;
            position: relative;
        }

            .icon-medical::before {
                content: '';
                position: absolute;
                width: 5px;
                height: 1px;
                background: white;
                top: 3px;
                left: 2px;
                box-shadow: 0 2px 0 white, 0 5px 0 white;
            }

        .icon-notifications {
            position: relative;
        }

            .icon-notifications::before {
                content: '';
                position: absolute;
                width: 8px;
                height: 8px;
                background: white;
                border-radius: 50% 50% 0 0;
                top: 2px;
                left: 3px;
            }

            .icon-notifications::after {
                content: '';
                position: absolute;
                width: 10px;
                height: 2px;
                background: white;
                bottom: 1px;
                left: 2px;
            }

        .icon-agenda {
            border: 2px solid white;
            border-radius: 2px;
            position: relative;
        }

            .icon-agenda::before {
                content: '';
                position: absolute;
                width: 3px;
                height: 2px;
                background: white;
                top: 6px;
                left: 2px;
                transform: rotate(-45deg);
            }

            .icon-agenda::after {
                content: '';
                position: absolute;
                width: 5px;
                height: 2px;
                background: white;
                top: 5px;
                left: 4px;
                transform: rotate(45deg);
            }

        .icon-report {
            width: 14px;
            height: 14px;
            position: relative;
        }

            .icon-report::before {
                content: '';
                position: absolute;
                width: 2px;
                height: 7px;
                background: white;
                bottom: 0;
                left: 1px;
                box-shadow: 4px -2px 0 white, 8px -3px 0 white;
            }

        .icon-users {
            position: relative;
        }

            .icon-users::before {
                content: '';
                position: absolute;
                width: 5px;
                height: 5px;
                background: white;
                border-radius: 50%;
                top: 1px;
                left: 4px;
            }

            .icon-users::after {
                content: '';
                position: absolute;
                width: 8px;
                height: 5px;
                background: white;
                border-radius: 4px 4px 0 0;
                bottom: 0;
                left: 3px;
            }

        .icon-roles {
            position: relative;
        }

            .icon-roles::before {
                content: '';
                position: absolute;
                width: 5px;
                height: 5px;
                background: transparent;
                border: 2px solid white;
                border-radius: 50%;
                top: 1px;
                left: 1px;
            }

            .icon-roles::after {
                content: '';
                position: absolute;
                width: 5px;
                height: 2px;
                background: white;
                top: 3px;
                right: 0;
            }

        .icon-admin {
            position: relative;
        }

            .icon-admin::before {
                content: '';
                position: absolute;
                width: 10px;
                height: 12px;
                background: transparent;
                border: 2px solid white;
                border-radius: 2px 2px 5px 5px;
                top: 1px;
                left: 2px;
            }

            .icon-admin::after {
                content: '';
                position: absolute;
                width: 5px;
                height: 2px;
                background: white;
                top: 5px;
                left: 4px;
            }

        .dropdown-icon {
            width: 14px;
            height: 14px;
            display: inline-block;
            position: relative;
            flex-shrink: 0;
            margin-right: 6px;
        }

            .dropdown-icon.icon-users::before {
                content: '';
                position: absolute;
                width: 5px;
                height: 5px;
                background: var(--primary-blue);
                border-radius: 50%;
                top: 1px;
                left: 4px;
            }

            .dropdown-icon.icon-users::after {
                content: '';
                position: absolute;
                width: 8px;
                height: 5px;
                background: var(--primary-blue);
                border-radius: 4px 4px 0 0;
                bottom: 0;
                left: 3px;
            }

            .dropdown-icon.icon-roles::before {
                content: '';
                position: absolute;
                width: 5px;
                height: 5px;
                background: transparent;
                border: 2px solid var(--primary-blue);
                border-radius: 50%;
                top: 1px;
                left: 1px;
            }

            .dropdown-icon.icon-roles::after {
                content: '';
                position: absolute;
                width: 5px;
                height: 2px;
                background: var(--primary-blue);
                top: 3px;
                right: 0;
            }

        .navbar-nav .dropdown-menu {
            background: white;
            border: none;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            border-radius: 8px;
            padding: 0.4rem;
            min-width: 180px;
        }

        .navbar-nav .dropdown-item {
            border-radius: 6px;
            padding: 0.5rem 0.8rem;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            color: var(--text-dark);
            font-weight: 500;
            font-size: 0.85rem;
        }

            .navbar-nav .dropdown-item:hover {
                background: var(--bg-light);
                color: var(--primary-blue);
            }

        .navbar-nav .dropdown-toggle::after {
            margin-left: 5px;
        }

        .navbar-nav .dropdown-toggle {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 6px;
            padding: 0.4rem 0.8rem !important;
        }

            .navbar-nav .dropdown-toggle:hover {
                background: rgba(255, 255, 255, 0.2);
            }

        .user-avatar {
            width: 28px;
            height: 28px;
            background: linear-gradient(135deg, var(--accent-blue), var(--primary-blue-light));
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 6px;
            font-weight: 600;
            color: white;
            font-size: 0.8rem;
        }

        .dropdown-menu {
            border: none;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            border-radius: 10px;
            padding: 0.6rem;
            background: white;
        }

        .dropdown-item {
            border-radius: 6px;
            padding: 0.6rem 0.8rem;
            transition: all 0.2s ease;
            color: var(--text-dark);
            font-weight: 500;
            font-size: 0.85rem;
        }

            .dropdown-item:hover {
                background: var(--bg-light);
                color: var(--primary-blue);
            }

        .dropdown-item-text {
            padding: 0.6rem 0.8rem;
            display: block;
        }

        .dropdown-divider {
            margin: 0.4rem 0;
            border-color: var(--border-color);
        }

        .badge.bg-danger {
            background: linear-gradient(135deg, #ef4444, #dc2626) !important;
        }

        .badge.bg-success {
            background: linear-gradient(135deg, #10b981, #059669) !important;
        }

        .badge.bg-info {
            background: linear-gradient(135deg, var(--accent-blue), #0284c7) !important;
        }

        .container {
            max-width: 1200px;
        }

        main {
            min-height: calc(100vh - 180px);
            padding-bottom: 1.5rem;
        }

            main::after {
                content: '';
                display: block;
                clear: both;
            }

        .container {
            position: relative;
            overflow: hidden;
        }

        .footer {
            background: linear-gradient(135deg, var(--primary-blue-dark) 0%, var(--primary-blue) 100%);
            color: white;
            padding: 2rem 0 1rem;
            margin-top: 0;
            position: relative;
            overflow: hidden;
            clear: both;
        }

            .footer::before {
                display: none !important;
            }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 1.5rem;
            position: relative;
            z-index: 1;
        }

        .footer-section h5 {
            font-weight: 600;
            margin-bottom: 0.8rem;
            color: white;
            font-size: 1rem;
        }

        .footer-section p,
        .footer-section a {
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 0.4rem;
            text-decoration: none;
            display: block;
            transition: color 0.3s ease;
            font-size: 0.85rem;
        }

            .footer-section a:hover {
                color: white;
            }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 0.6rem;
        }

        .contact-icon {
            width: 30px;
            height: 30px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

            .contact-icon svg {
                stroke: white;
                width: 16px;
                height: 16px;
            }

        .footer-bottom {
            text-align: center;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.85rem;
        }

        .navbar-toggler {
            border-color: rgba(255, 255, 255, 0.3);
            padding: 0.4rem;
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(255, 255, 255, 0.9)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        .navbar-toggler:focus {
            box-shadow: 0 0 0 0.2rem rgba(255, 255, 255, 0.25);
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <div class="logo-icon"></div>
                    AnimalCare Veterinary Clinic
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Owners" asp-action="Index">
                                        <span class="nav-icon icon-owners"></span> Owners
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Animals" asp-action="Index">
                                        <span class="nav-icon icon-animals"></span> Animals
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Veterinarians" asp-action="Index">
                                        <span class="nav-icon icon-vets"></span> Vets
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Appointments" asp-action="Index">
                                        <span class="nav-icon icon-appointments"></span> Appointments
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Schedules" asp-action="Index">
                                        <span class="nav-icon icon-schedules"></span> Schedules
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="MedicalHistories" asp-action="Index">
                                        <span class="nav-icon icon-medical"></span> Medical
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Notifications" asp-action="Index">
                                        <span class="nav-icon icon-notifications"></span> Notifications
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="DailyAgenda" asp-action="Index">
                                        <span class="nav-icon icon-agenda"></span> Agenda
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="MonthlyReport" asp-action="Index">
                                        <span class="nav-icon icon-report"></span> Report
                                    </a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="adminMenu"
                                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <span class="nav-icon icon-admin"></span> Admin
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="adminMenu">
                                        <li>
                                            <a class="dropdown-item" asp-controller="UserAccounts" asp-action="Index">
                                                <span class="dropdown-icon icon-users"></span> User Accounts
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Roles" asp-action="Index">
                                                <span class="dropdown-icon icon-roles"></span> Manage Roles
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else if (User.IsInRole("Veterinarian"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Owners" asp-action="Index">
                                        <span class="nav-icon icon-owners"></span> Owners
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Animals" asp-action="Index">
                                        <span class="nav-icon icon-animals"></span> Animals
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Appointments" asp-action="Index">
                                        <span class="nav-icon icon-appointments"></span> Appointments
                                    </a>
                                </li>
                                @* <li class="nav-item">
                                    <a class="nav-link" asp-controller="MedicalHistories" asp-action="Index">
                                        <span class="nav-icon icon-medical"></span> Medical
                                    </a>
                                </li> *@
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Schedules" asp-action="Index">
                                        <span class="nav-icon icon-schedules"></span> Schedule
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="DailyAgenda" asp-action="Index">
                                        <span class="nav-icon icon-agenda"></span> Agenda
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Notifications" asp-action="Index">
                                        <span class="nav-icon icon-notifications"></span> Notifications
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Receptionist"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Owners" asp-action="Index">
                                        <span class="nav-icon icon-owners"></span> Owners
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Animals" asp-action="Index">
                                        <span class="nav-icon icon-animals"></span> Animals
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Appointments" asp-action="Index">
                                        <span class="nav-icon icon-appointments"></span> Appointments
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Schedules" asp-action="Index">
                                        <span class="nav-icon icon-schedules"></span> Schedules
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="DailyAgenda" asp-action="Index">
                                        <span class="nav-icon icon-agenda"></span> Agenda
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Notifications" asp-action="Index">
                                        <span class="nav-icon icon-notifications"></span> Notifications
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userMenu"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="user-avatar">
                                        @User.Identity.Name?.Substring(0, 1).ToUpper()
                                    </span>
                                    @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                                    <li>
                                        <div class="dropdown-item-text">
                                            <div style="font-size: 0.75rem; color: #64748b; margin-bottom: 4px;">Role</div>
                                            @if (User.IsInRole("Administrator"))
                                            {
                                                <span class="badge bg-danger">Administrator</span>
                                            }
                                            else if (User.IsInRole("Veterinarian"))
                                            {
                                                <span class="badge bg-success">Veterinarian</span>
                                            }
                                            else if (User.IsInRole("Receptionist"))
                                            {
                                                <span class="badge bg-info">Receptionist</span>
                                            }
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px;">
                                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                                    <polyline points="16 17 21 12 16 7" />
                                                    <line x1="21" y1="12" x2="9" y2="12" />
                                                </svg>
                                                Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Login">
                                    Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
