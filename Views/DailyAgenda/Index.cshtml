@model IEnumerable<AnimalCareVeterinaryClinicDBFirst.Models.DailyAgendum>

@{
    ViewData["Title"] = "Daily Agenda";
}

<div class="table-card">
    <div class="table-card-header">
        <div class="header-content">
            <div class="header-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                    <line x1="8" y1="14" x2="8" y2="14.01"></line>
                    <line x1="12" y1="14" x2="12" y2="14.01"></line>
                    <line x1="16" y1="14" x2="16" y2="14.01"></line>
                    <line x1="8" y1="18" x2="8" y2="18.01"></line>
                    <line x1="12" y1="18" x2="12" y2="18.01"></line>
                    <line x1="16" y1="18" x2="16" y2="18.01"></line>
                </svg>
            </div>
            <h2>Daily Agenda</h2>
        </div>
        <div class="current-date">
            <svg class="date-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            @DateTime.Now.ToString("MMMM dd, yyyy")
        </div>
    </div>

    <div class="table-responsive">
        <table class="pretty-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Veterinarian</th>
                    <th>Animal</th>
                    <th>Owner</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="date-cell">
                                <svg class="date-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                                <strong>@item.Date?.ToString("MMM dd, yyyy")</strong>
                            </div>
                        </td>
                        <td>
                            <div class="time-range">
                                <svg class="time-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                                <div>
                                    <div class="time-start">@item.StartTime</div>
                                    <div class="time-divider">→</div>
                                    <div class="time-end">@item.EndTime</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="vet-cell">
                                <span class="vet-avatar-small">@item.VeterinarianName?.Substring(0, Math.Min(2, item.VeterinarianName.Length)).ToUpper()</span>
                                <strong>@item.VeterinarianName</strong>
                            </div>
                        </td>
                        <td>
                            <div class="animal-cell">
                                <svg class="animal-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="11" cy="4" r="2"></circle>
                                    <circle cx="18" cy="8" r="2"></circle>
                                    <circle cx="20" cy="16" r="2"></circle>
                                    <circle cx="4" cy="8" r="2"></circle>
                                    <circle cx="2" cy="16" r="2"></circle>
                                    <path d="M11 6v10"></path>
                                </svg>
                                @item.AnimalName
                            </div>
                        </td>
                        <td>
                            <div class="owner-cell">
                                <svg class="owner-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                                @item.OwnerName
                            </div>
                        </td>
                        <td>
                            @{
                                var statusClass = item.AppointmentStatus?.ToLower() switch
                                {
                                    "completed" => "completed",
                                    "canceled" => "canceled",
                                    _ => "planned"
                                };
                            }
                            <span class="status-badge @statusClass">
                                <span class="status-dot"></span>
                                @item.AppointmentStatus
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    :root {
        --primary-blue: #2563eb;
        --primary-blue-dark: #1e40af;
        --success-green: #059669;
        --danger-red: #dc2626;
        --bg-light: #f8fafc;
        --text-dark: #1e293b;
        --border-color: #e2e8f0;
    }

    .table-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        margin: 1.5rem 0;
    }

    .table-card-header {
        padding: 1.2rem 1.5rem;
        background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-content {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .header-icon {
        width: 32px;
        height: 32px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .header-icon svg {
            width: 20px;
            height: 20px;
            color: white;
        }

    .table-card-header h2 {
        color: white;
        font-weight: 700;
        margin: 0;
        font-size: 1.4rem;
    }

    .current-date {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0.6rem 1rem;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        color: white;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .date-badge-icon {
        width: 18px;
        height: 18px;
        color: white;
        flex-shrink: 0;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .pretty-table {
        width: 100%;
        border-collapse: collapse;
    }

        .pretty-table thead {
            background: var(--bg-light);
        }

        .pretty-table th {
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            color: var(--text-dark);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid var(--border-color);
        }

        .pretty-table td {
            padding: 1rem;
            border-bottom: 1px solid var(--border-color);
            color: #1e293b;
            font-size: 0.9rem;
        }

        .pretty-table tbody tr {
            transition: background 0.2s ease;
        }

            .pretty-table tbody tr:hover {
                background: var(--bg-light);
            }

    .date-cell {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .date-icon {
        width: 18px;
        height: 18px;
        color: var(--primary-blue);
        flex-shrink: 0;
    }

    .time-range {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .time-icon {
        width: 16px;
        height: 16px;
        color: #0ea5e9;
        flex-shrink: 0;
    }

    .time-range > div {
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 500;
    }

    .time-divider {
        color: #94a3b8;
        font-size: 0.8rem;
    }

    .vet-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .vet-avatar-small {
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, var(--success-green), #047857);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 0.75rem;
        flex-shrink: 0;
    }

    .animal-cell {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .animal-icon {
        width: 16px;
        height: 16px;
        color: var(--primary-blue);
        flex-shrink: 0;
    }

    .owner-cell {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .owner-icon {
        width: 16px;
        height: 16px;
        color: #64748b;
        flex-shrink: 0;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .status-badge.planned {
        background: #dbeafe;
        color: #1e40af;
    }

        .status-badge.planned .status-dot {
            background: #1e40af;
        }

    .status-badge.completed {
        background: #dcfce7;
        color: #15803d;
    }

        .status-badge.completed .status-dot {
            background: #15803d;
        }

    .status-badge.canceled {
        background: #fee2e2;
        color: #991b1b;
    }

        .status-badge.canceled .status-dot {
            background: #991b1b;
        }

    @@media (max-width: 768px) {
        .table-card-header {
            flex-direction: column;
            gap: 1rem;
            align-items: stretch;
        }

        .current-date {
            justify-content: center;
        }

        .pretty-table {
            font-size: 0.85rem;
        }

            .pretty-table th,
            .pretty-table td {
                padding: 0.7rem;
            }

        .time-range > div {
            flex-direction: column;
            gap: 2px;
            align-items: flex-start;
        }

        .time-divider {
            display: none;
        }
    }
</style>
